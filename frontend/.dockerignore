# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be generated during docker build)
dist/
build/

# Environment files
.env
.env.local
.env.development
# Note: .env.production is needed in build, so we don't ignore it

# Git files
.git/
.gitignore
.gitattributes

# Test files
tests/
test/
*.test.js
*.spec.js
coverage/

# Documentation
*.md
docs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Log files
logs/
*.log

# Temporary files
tmp/
temp/

# Vite cache
.vite/
